[2.296829, "o", "\u001b[1mdiff --git a/src/auth.rs b/src/auth.rs\u001b[m\r\n\u001b[1mindex 3315bb5..a34f2ff 100644\u001b[m\r\n\u001b[1m--- a/src/auth.rs\u001b[m\r\n\u001b[1m+++ b/src/auth.rs\u001b[m\r\n\u001b[36m@@ -1,4 +1,6 @@\u001b[m\r\n\u001b[31m-//! Authentication helpers: token validation and session loading.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m//! Authentication helpers.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m//!\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m//! Token validation and session loading for the auth module.\u001b[m\r\n \u001b[m\r\n use std::collections::HashMap;\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -17,7 +19,7 @@\u001b[m \u001b[mpub struct Session {\u001b[m\r\n pub fn check_token(token: &str) -> bool {\u001b[m\r\n     let expires_at = parse_expiry(token);\u001b[m\r\n     let now = current_time();\u001b[m\r\n\u001b[31m-    if now > expires_at {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if now >= expires_at {\u001b[m\r\n         return false;\u001b[m\r\n"]
[2.296921, "o", "     }\u001b[m\r\n     true\u001b[m\r\n\u001b[36m@@ -37,6 +39,14 @@\u001b[m \u001b[mpub fn current_time() -> u64 {\u001b[m\r\n     1_700_000_000\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m/// Exchange an OAuth2 authorization code for an access token.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mpub fn oauth2_login(code: &str) -> Result<String, String> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if code.is_empty() {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return Err(\"empty code\".into());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Ok(format!(\"token-{code}\"))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n /// Load a session for a user id, if one exists.\u001b[m\r\n pub fn load_session(user_id: u64, store: &HashMap<String, Session>) -> Option<&Session> {\u001b[m\r\n     store.get(&user_id.to_string())\u001b[m\r\n"]
